# ── Ollama (Local LLM — default) ───────────────────────────────────────────────
# Default model: medgemma:latest (Google's medical-grade model via Ollama Cloud)
# Pull it first: ollama pull medgemma:latest
OLLAMA_BASE_URL=http://localhost:11434

# ── Google Gemini (Cloud) ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── OpenAI (Cloud) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
